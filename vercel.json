{
  "buildCommand": "npm run build:prerender",
  "rewrites": [
    {
      "source": "/article/:slug",
      "destination": "/api/prerender?type=article&slug=:slug"
    },
    {
      "source": "/category/:slug",
      "destination": "/api/prerender?type=category&slug=:slug"
    },
    {
      "source": "/((?!api/|assets/|prerender/|404\\.html|410\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*).js",
      "headers": [
        {
          "key": "Content-Type", 
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/assets/(.*).mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/assets/(.*).css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    }
  ]
}