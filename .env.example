# AI News Frontend Environment Configuration

# API Configuration
VITE_API_BASE=https://ai-news-backend-production-9866.up.railway.app

# Supabase Configuration for Category Images
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Debug Configuration
# Set to 'true' to enable comprehensive debug logging
# This includes entrance/exit logging for all functions with parameters and return values
VITE_DEBUG_MODE=false

# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Analytics Configuration (Optional)
VITE_GA_MEASUREMENT_ID=your_google_analytics_id_here

# Feature Flags
VITE_ENABLE_ADMIN_FEATURES=true
VITE_ENABLE_BETA_FEATURES=false

# Development/Testing Flags
VITE_BYPASS_AUTH=false
VITE_MOCK_API=false

# Performance Settings
VITE_API_TIMEOUT=60000
VITE_CONTENT_API_TIMEOUT=90000

# Social Media Links
VITE_SOCIAL_LINKEDIN=https://www.linkedin.com/in/your-profile
VITE_SOCIAL_TWITTER=https://x.com/your-handle
VITE_SOCIAL_YOUTUBE=https://www.youtube.com/@your-channel
VITE_SOCIAL_GITHUB=https://github.com/your-org
VITE_SOCIAL_MEDIUM=https://medium.com/@your-publication
VITE_SOCIAL_SUBSTACK=https://substack.com/@your-newsletter
VITE_SOCIAL_REDDIT=https://www.reddit.com/user/your-profile/
VITE_SOCIAL_KAGGLE=https://www.kaggle.com/your-profile
VITE_SOCIAL_DISCORD=https://discord.gg/your-invite